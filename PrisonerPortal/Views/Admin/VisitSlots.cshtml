@model IEnumerable<PrisonerPortal.Models.Entities.VisitSlot>
@{
    ViewData["Title"] = "Visit Slots Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="font-serif fw-bold mb-0">Visit Schedule</h2>
        <p class="text-muted mb-0">Manage availability slots for family bookings.</p>
    </div>
    <a asp-action="CreateSlot" class="btn btn-primary fw-bold shadow-sm">
        <i class="fa-solid fa-plus me-2"></i> Create Slot
    </a>
</div>

<div class="card content-card p-0">
    <div class="table-responsive">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Time Window</th>
                    <th>Capacity</th>
                    <th>Bookings</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var slot in Model.OrderBy(s => s.SlotDate).ThenBy(s => s.StartTime))
                    {
                        <tr>
                            <td class="fw-semibold text-dark">
                                <i class="fa-regular fa-calendar me-2 text-muted"></i>@slot.SlotDate.ToString("ddd, MMM dd, yyyy")
                                @if (slot.SlotDate.Date == DateTime.UtcNow.Date)
                                {
                                    <span class="badge bg-primary ms-2 small">Today</span>
                                }
                            </td>
                            <td class="font-mono">
                                <i class="fa-regular fa-clock me-2 text-muted"></i>@slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm")
                            </td>
                            <td class="text-center font-mono">@slot.MaxCapacity</td>
                            <td>
                                @{
                                    var percent = (double)slot.CurrentBookings / slot.MaxCapacity * 100;
                                    var colorClass = percent >= 100 ? "bg-danger" : (percent >= 70 ? "bg-warning" : "bg-success");
                                }
                                <div class="d-flex align-items-center">
                                    <span class="fw-bold font-mono me-2" style="width: 40px;">@slot.CurrentBookings / @slot.MaxCapacity</span>
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar @colorClass" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (percent >= 100)
                                {
                                    <span class="badge-status rejected">Full</span>
                                }
                                else if (slot.SlotDate < DateTime.UtcNow.Date)
                                {
                                    <span class="badge-status low">Past</span>
                                }
                                else
                                {
                                    <span class="badge-status approved">Available</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteSlot" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this slot?');">
                                    <input type="hidden" name="id" value="@slot.SlotId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" @(slot.CurrentBookings > 0 ? "disabled" : "") data-bs-toggle="tooltip" title="Delete (only if empty)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state p-5">
                                <i class="fa-regular fa-calendar-xmark empty-state-icon opacity-50"></i>
                                <h6>No visit slots found for the next 7 days.</h6>
                                <p class="text-muted small">Create slots to allow families to book visits.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
