@model IEnumerable<PrisonerPortal.Models.Entities.Prisoner>
@{
    ViewData["Title"] = "Prisoner Registry";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="font-serif fw-bold mb-0">Prisoner Registry</h2>
        <p class="text-muted mb-0">Manage and track prisoner records</p>
    </div>
    <a asp-action="AddPrisoner" class="btn btn-primary fw-bold shadow-sm">
        <i class="fa-solid fa-plus me-2"></i> Add Prisoner
    </a>
</div>

<div class="card content-card p-0 border-top border-4 border-primary">
    <div class="card-header bg-white border-bottom p-4">
        <div class="input-group" style="max-width: 400px;">
            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0 bg-light" placeholder="Search by name, code, or case..." onkeyup="filterTable(this)">
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-custom table-hover mb-0" id="prisonerTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Full Name</th>
                    <th>Case # / Crime</th>
                    <th>Cell Assignment</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prisoner in Model)
                {
                    <tr data-href="/Admin/ViewPrisoner/@prisoner.PrisonerId" class="clickable">
                        <td class="font-mono text-primary fw-semibold">@prisoner.PrisonerCode</td>
                        <td class="fw-bold text-dark">
                            @prisoner.FullName
                            <div class="fw-normal text-muted small"><i class="fa-solid fa-cake-candles me-1"></i> @prisoner.DateOfBirth.ToString("yyyy") (@prisoner.Gender)</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@prisoner.CaseNumber</div>
                            <span class="badge bg-light text-dark border mt-1">@prisoner.CrimeCategory</span>
                        </td>
                        <td>
                            <div><i class="fa-solid fa-building text-muted me-2"></i>@prisoner.CellBlock</div>
                            <small class="text-muted"><i class="fa-solid fa-door-closed me-2"></i>Cell @prisoner.CellNumber</small>
                        </td>
                        <td>
                            @if(prisoner.Status == "Active")
                            {
                                <span class="badge-status active">Active</span>
                            }
                            else if (prisoner.Status == "Released")
                            {
                                <span class="badge-status completed">Released</span>
                            }
                            else
                            {
                                <span class="badge-status pending">Transferred</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="ViewPrisoner" asp-route-id="@prisoner.PrisonerId" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="View Details">
                                <i class="fa-regular fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable(input) {
            let filter = input.value.toLowerCase();
            let table = document.getElementById("prisonerTable");
            let tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                let textValue = tr[i].textContent || tr[i].innerText;
                if (textValue.toLowerCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    </script>
}
