@model IEnumerable<PrisonerPortal.Models.Entities.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="font-serif fw-bold mb-0">System Users</h2>
    
    <div class="d-flex gap-2">
        <form class="d-flex gap-2" method="get">
            <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Roles</option>
                <option value="Admin">Administrators</option>
                <option value="Family">Families</option>
            </select>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All Statuses</option>
                <option value="Active">Active Only</option>
                <option value="Inactive">Inactive Only</option>
            </select>
        </form>
    </div>
</div>

<div class="card content-card p-0">
    <div class="table-responsive">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Contact</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                    <strong>@user.FullName.Substring(0,1).ToUpper()</strong>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <small class="text-muted font-mono">ID: @user.Id.Substring(0, 8)</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div><i class="fa-regular fa-envelope text-muted me-2"></i>@user.Email</div>
                            <small><i class="fa-solid fa-phone text-muted me-2"></i>@(user.PhoneNumber ?? "N/A")</small>
                        </td>
                        <td>
                            @if(user.Role == "Admin")
                            {
                                <span class="badge bg-danger text-white border border-danger shadow-sm"><i class="fa-solid fa-shield-halved me-1"></i> Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark border border-secondary shadow-sm">Family</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge-status active d-inline-block"><i class="fa-solid fa-circle me-1 small"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge-status rejected d-inline-block"><i class="fa-regular fa-circle ms-1 small"></i> Inactive</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                @if (user.Role == "Family")
                                {
                                    <a asp-action="FamilyLinks" asp-route-filter="verified" class="btn btn-sm btn-outline-info shadow-sm" title="View Prisoner Links">
                                        <i class="fa-solid fa-link"></i>
                                    </a>
                                }
                                <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    @if (user.Role != "Admin")
                                    {
                                        <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success") fw-semibold shadow-sm"
                                                title="@(user.IsActive ? "Deactivate" : "Activate")"
                                                onclick="return confirm('@(user.IsActive ? "Deactivate" : "Activate") this user?')">
                                            <i class="fa-solid @(user.IsActive ? "fa-ban" : "fa-check")"></i>
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
