@model IEnumerable<PrisonerPortal.Models.Entities.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="row w-100 m-0">
    <div class="col-12 col-xl-10 col-xxl-8 mx-auto">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="font-serif fw-bold mb-0">Your Notifications</h2>
                <p class="text-muted mb-0">Stay updated on your visit approvals, support requests, and facility alerts.</p>
            </div>
            @if(Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllAsRead" method="post">
                    <button type="submit" class="btn btn-outline-primary shadow-sm"><i class="fa-solid fa-check-double me-2"></i>Mark All as Read</button>
                </form>
            }
        </div>

        <div class="card content-card p-0 overflow-hidden">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach(var notification in Model.OrderByDescending(n => n.CreatedAt))
                    {
                        var bgClass = notification.IsRead ? "bg-white" : "bg-primary bg-opacity-10";
                        var icon = notification.Type switch
                        {
                            "Appointment" => "fa-calendar-check text-success",
                            "SupportRequest" => "fa-headset text-accent",
                            "System" => "fa-circle-info text-primary",
                            "Security" => "fa-triangle-exclamation text-danger",
                            _ => "fa-bell text-muted"
                        };
                        
                        <div class="list-group-item p-4 @bgClass border-bottom transition-all" style="transition: background-color 0.2s;">
                            <div class="d-flex align-items-start">
                                <div class="avatar bg-white rounded-circle shadow-sm me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 45px; height: 45px; font-size: 1.25rem;">
                                    <i class="fa-solid @icon"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="fw-bold mb-0 @(notification.IsRead ? "text-dark" : "text-primary")">@notification.Title</h6>
                                        <small class="text-muted"><i class="fa-regular fa-clock me-1"></i>@notification.CreatedAt.ToString("g")</small>
                                    </div>
                                    <p class="mb-2 text-dark">@notification.Message</p>
                                    
                                    <div class="d-flex justify-content-end align-items-center mt-2">
                                        @if(!notification.IsRead)
                                        {
                                            <form action="/Notifications/MarkAsRead" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@notification.NotificationId" />
                                                <button type="submit" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold text-primaey">Mark Read</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state p-5">
                    <i class="fa-regular fa-bell-slash empty-state-icon fs-1 opacity-50 mb-3 text-muted"></i>
                    <h5 class="fw-bold text-dark">All Caught Up!</h5>
                    <p class="text-muted mb-0 mx-auto" style="max-width: 300px;">You have no notifications at this time. We'll notify you when there's an update.</p>
                </div>
            }
        </div>
    </div>
</div>
