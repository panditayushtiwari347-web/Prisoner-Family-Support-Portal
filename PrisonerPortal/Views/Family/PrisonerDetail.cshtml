@model PrisonerPortal.Models.Entities.Prisoner
@{
    ViewData["Title"] = "Inmate Profile";
    var upcomingVisit = ViewBag.UpcomingVisit as PrisonerPortal.Models.Entities.Appointment;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="font-serif fw-bold mb-0">Linked Inmate Dashboard</h2>
        <p class="text-muted mb-0">Overview for <span class="fw-bold text-dark">@Model.FullName</span>.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Main Profile Card -->
    <div class="col-lg-8">
        <div class="card content-card border-top border-4 border-success p-0 mb-4 h-100">
            <div class="card-body p-4 p-md-5 d-flex flex-column flex-md-row align-items-center align-items-md-start">
                <div class="avatar bg-success text-white rounded-circle d-flex justify-content-center align-items-center mb-4 mb-md-0 me-md-5 shadow" style="width: 120px; height: 120px; font-size: 3rem;">
                    <i class="fa-solid fa-user"></i>
                </div>
                
                <div class="text-center text-md-start w-100">
                    <div class="d-flex justify-content-center justify-content-md-between align-items-start mb-2 flex-wrap">
                        <h2 class="fw-bold font-serif mb-0 text-dark">@Model.FullName</h2>
                        <span class="badge-status active d-none d-md-inline-block mt-2 mt-md-0"><i class="fa-solid fa-check-circle me-1"></i> Official Record</span>
                    </div>
                    
                    <div class="d-flex flex-wrap gap-2 gap-md-4 justify-content-center justify-content-md-start mt-3 mb-4">
                        <div class="bg-surface px-4 py-2 rounded border">
                            <span class="small text-muted d-block text-uppercase fw-bold">Prisoner Code</span>
                            <span class="fw-bold font-mono fs-5 text-primary">@Model.PrisonerCode</span>
                        </div>
                        <div class="bg-surface px-4 py-2 rounded border">
                            <span class="small text-muted d-block text-uppercase fw-bold">Birth Year</span>
                            <span class="fw-bold fs-5 text-dark">@Model.DateOfBirth.ToString("yyyy")</span>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25" />

                    <div class="row g-4 mt-1 text-start">
                        <div class="col-sm-6">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2"><i class="fa-solid fa-building me-2"></i> Current Housing</h6>
                            <div class="fw-bold text-dark fs-5">@Model.CellBlock</div>
                            <div class="text-muted small mt-1">Movement Restrictions Apply</div>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2"><i class="fa-solid fa-gavel me-2"></i> Intake Basis</h6>
                            <div class="fw-bold text-dark fs-5">@Model.CrimeCategory</div>
                            <div class="text-muted small mt-1 font-mono">Case: @Model.CaseNumber</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <!-- Next Visit -->
        <div class="card content-card bg-primary text-white border-0 shadow mb-4 p-0 overflow-hidden">
            <div class="card-header bg-transparent border-white border-opacity-25 p-4 pb-2">
                <h6 class="fw-bold font-serif mb-0 text-white"><i class="fa-regular fa-calendar-check text-accent me-2"></i> Next Approved Visit</h6>
            </div>
            <div class="card-body p-4 pt-3">
                @if(upcomingVisit != null)
                {
                    <div class="bg-white bg-opacity-10 p-3 rounded mb-3">
                        <div class="text-accent fw-bold fs-4 mb-1">@upcomingVisit.Slot!.SlotDate.ToString("MMM dd, yyyy")</div>
                        <div class="font-mono">Time: @upcomingVisit.Slot.StartTime.ToString(@"hh\:mm") - @upcomingVisit.Slot.EndTime.ToString(@"hh\:mm")</div>
                        <div class="small opacity-75 mt-2">Ref: @upcomingVisit.AppointmentCode</div>
                    </div>
                    <a asp-action="MyAppointments" class="btn btn-light text-primary w-100 fw-bold">Manage Visit</a>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fa-solid fa-calendar-xmark fs-2 mb-3 opacity-50 text-white"></i>
                        <h6 class="mb-3 text-white">No visits scheduled.</h6>
                        <a asp-action="BookVisit" asp-route-prisonerId="@Model.PrisonerId" class="btn btn-accent text-white w-100 fw-bold shadow-sm">Book New Visit</a>
                    </div>
                }
            </div>
        </div>

        <!-- Queries -->
        <div class="card content-card border-top border-4 border-accent p-0">
            <div class="card-body p-4 text-center">
                <div class="avatar bg-accent bg-opacity-10 text-accent rounded-circle d-flex justify-content-center align-items-center mb-3 mx-auto" style="width: 60px; height: 60px; font-size: 1.5rem;">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <h5 class="fw-bold font-serif mb-2">Need Assistance?</h5>
                <p class="text-muted small mb-4">Submit a query to the administration regarding @Model.FullName's medical needs, belongings, or general info.</p>
                <a asp-action="SubmitRequest" asp-route-prisonerId="@Model.PrisonerId" class="btn btn-outline-primary w-100 fw-bold">Submit Query</a>
            </div>
        </div>
    </div>
</div>
