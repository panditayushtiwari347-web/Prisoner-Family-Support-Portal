@model PrisonerPortal.Models.Entities.SupportRequest
@{
    ViewData["Title"] = "Request Tracking";
}

<div class="mb-4">
    <a asp-action="MyRequests" class="btn btn-sm btn-light text-muted mb-3"><i class="fa-solid fa-arrow-left me-2"></i>Back to Tracker list</a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="font-serif fw-bold mb-1"><span class="font-mono text-primary text-opacity-50 me-2">@Model.RequestCode</span> @Model.Subject</h2>
            <div class="d-flex gap-2">
                <span class="badge bg-secondary">@Model.Category</span>
                <span class="badge bg-light text-dark border"><i class="fa-regular fa-clock me-1"></i>@Model.CreatedAt.ToString("f")</span>
            </div>
        </div>
        <div class="text-end">
            @{
                var statusClass = Model.Status == "Open" ? "pending" : (Model.Status == "Resolved" ? "completed" : (Model.Status == "InProgress" ? "active" : "low"));
            }
            <span class="badge-status @statusClass fs-6 px-4 py-2 shadow-sm d-inline-block border border-white">Status: @Model.Status</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <!-- Original Request -->
        <div class="card content-card mb-4 p-0 overflow-hidden shadow-sm">
            <div class="card-header bg-light border-bottom p-3 d-flex align-items-center">
                <div class="avatar bg-secondary text-white rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-0">Your Query</h6>
                    <small class="text-muted">Submitted on @Model.CreatedAt.ToString("g")</small>
                </div>
            </div>
            <div class="card-body p-4 bg-white text-dark" style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.6;">@Model.Description</div>
        </div>

        <!-- Official Administration Response -->
        <div class="d-flex justify-content-center mb-4 text-muted"><i class="fa-solid fa-arrow-down-long"></i></div>

        @if (!string.IsNullOrEmpty(Model.AdminResponse))
        {
            <div class="card content-card border-top border-4 border-success bg-white shadow">
                <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                    <div class="avatar bg-success text-white rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 45px; height: 45px;">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-success mb-0 font-serif">Official Facility Response</h5>
                        <small class="text-muted">Responded on @(Model.UpdatedAt.ToString("f"))</small>
                    </div>
                </div>
                <div class="text-dark bg-surface p-4 rounded border border-success border-opacity-25" style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.6;">@Model.AdminResponse</div>
                
                @if (Model.Status == "Resolved")
                {
                    <div class="mt-4 pt-4 border-top text-center text-muted">
                        <i class="fa-solid fa-check-double text-success fs-4 mb-2"></i>
                        <p class="mb-0">This tracker case has been marked as remotely resolved.</p>
                    </div>
                }
                else
                {
                    <div class="mt-4 pt-3 text-end">
                        <form asp-action="ResolveRequest" method="post" onsubmit="return confirm('If your query was answered satisfactorily, mark this resolved. Yes?');">
                            <input type="hidden" name="id" value="@Model.RequestId"/>
                            <button type="submit" class="btn btn-outline-success border-2 fw-bold px-4">
                                <i class="fa-solid fa-check me-2"></i> I accept this response, mark resolved
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card content-card p-0 text-center border-dashed border-2 bg-transparent shadow-none" style="border-color: #cbd5e1 !important; border-style: dashed !important;">
                <div class="card-body p-5">
                    <div class="spinner-border text-primary ms-auto mb-3 opacity-50" style="width: 3rem; height: 3rem;" role="status"></div>
                    <h5 class="fw-bold text-muted">Awaiting Administration Response</h5>
                    <p class="text-muted small mx-auto mb-0" style="max-width:300px;">Facility staff have been notified and will respond. High priority items are addressed within 24-48 hours.</p>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar Info -->
    <div class="col-lg-4">
        <div class="card content-card p-4 mb-4">
            <h6 class="fw-bold font-serif mb-3 pb-2 border-bottom"><i class="fa-solid fa-circle-info text-primary me-2"></i> Case Information</h6>
            
            <div class="mb-3">
                <div class="text-muted small fw-bold text-uppercase">Tracking Code</div>
                <div class="fw-semibold font-mono fs-5 text-dark">@Model.RequestCode</div>
            </div>
            
            <div class="mb-3">
                <div class="text-muted small fw-bold text-uppercase">Declared Priority</div>
                <span class="badge-status @Model.Priority.ToLower() mt-1 d-inline-block">@Model.Priority Priority</span>
            </div>

            @if (Model.Prisoner != null)
            {
                <div class="mb-0 mt-4">
                    <div class="text-muted small fw-bold text-uppercase mb-2">Regarding Inmate</div>
                    <div class="bg-surface p-3 rounded border">
                        <div class="fw-bold text-dark"><i class="fa-solid fa-user-lock me-2 text-primary"></i>@Model.Prisoner.FullName</div>
                        <div class="font-mono small text-muted mt-1">Ref: @Model.Prisoner.PrisonerCode</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
