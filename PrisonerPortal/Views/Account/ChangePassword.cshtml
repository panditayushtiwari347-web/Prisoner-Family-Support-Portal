@model PrisonerPortal.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card content-card shadow-sm">
            <div class="card-header bg-white border-bottom pb-3 pt-4 px-4">
                <div class="d-flex align-items-center">
                    <a asp-action="Profile" class="btn btn-sm btn-light me-3">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <div>
                        <h4 class="font-serif fw-bold mb-0"><i class="fa-solid fa-key text-primary me-2"></i>Change Password</h4>
                        <small class="text-muted">Update your account password</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

                <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                    @Html.AntiForgeryToken()

                    <!-- Current Password -->
                    <div class="mb-4">
                        <label asp-for="OldPassword" class="form-label fw-semibold">
                            <i class="fa-solid fa-lock-open text-muted me-1"></i> Current Password
                        </label>
                        <div class="input-group">
                            <input asp-for="OldPassword" type="password" class="form-control form-control-lg" 
                                   id="oldPasswordInput" placeholder="Enter current password" />
                            <button class="btn btn-outline-secondary" type="button" onclick="toggleVisibility('oldPasswordInput', this)">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="OldPassword" class="text-danger small"></span>
                    </div>

                    <hr class="text-muted opacity-25 mb-4" />

                    <!-- New Password -->
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">
                            <i class="fa-solid fa-lock text-primary me-1"></i> New Password
                        </label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control form-control-lg" 
                                   id="newPasswordInput" placeholder="Min. 8 characters" />
                            <button class="btn btn-outline-secondary" type="button" onclick="toggleVisibility('newPasswordInput', this)">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text text-muted mt-1">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Must contain uppercase, lowercase, number, and special character (@@, $, !, %, *, ?, &amp;).
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                            <i class="fa-solid fa-lock text-success me-1"></i> Confirm New Password
                        </label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" 
                                   id="confirmPasswordInput" placeholder="Re-enter new password" />
                            <button class="btn btn-outline-secondary" type="button" onclick="toggleVisibility('confirmPasswordInput', this)">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Strength indicator -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted fw-semibold">Password Strength</small>
                            <small id="strengthLabel" class="text-muted">—</small>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div id="strengthBar" class="progress-bar" role="progressbar" style="width: 0%; transition: all 0.3s;"></div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Profile" class="btn btn-light flex-fill">Cancel</a>
                        <button type="submit" class="btn btn-primary flex-fill fw-bold">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Update Password
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Security Tips -->
        <div class="card content-card mt-3 bg-light border-0">
            <div class="card-body p-3">
                <h6 class="fw-bold text-muted mb-2"><i class="fa-solid fa-shield-halved me-2 text-success"></i>Tips for a strong password</h6>
                <ul class="list-unstyled small text-muted mb-0">
                    <li><i class="fa-solid fa-check text-success me-2"></i>At least 8 characters long</li>
                    <li><i class="fa-solid fa-check text-success me-2"></i>Mix of uppercase &amp; lowercase letters</li>
                    <li><i class="fa-solid fa-check text-success me-2"></i>At least one number</li>
                    <li><i class="fa-solid fa-check text-success me-2"></i>At least one special character (@@, $, !, etc.)</li>
                    <li><i class="fa-solid fa-check text-success me-2"></i>Don't reuse old passwords</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // Password strength meter
        document.getElementById('newPasswordInput').addEventListener('input', function () {
            const val = this.value;
            let score = 0;
            if (val.length >= 8)   score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[a-z]/.test(val)) score++;
            if (/\d/.test(val))    score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const bar = document.getElementById('strengthBar');
            const label = document.getElementById('strengthLabel');
            const colors = ['', 'bg-danger', 'bg-warning', 'bg-info', 'bg-primary', 'bg-success'];
            const labels = ['', 'Very Weak', 'Weak', 'Fair', 'Good', 'Strong'];

            bar.style.width = (score * 20) + '%';
            bar.className = 'progress-bar ' + (colors[score] || '');
            label.textContent = labels[score] || '—';
            label.className = 'small fw-semibold ' + (score >= 4 ? 'text-success' : score >= 3 ? 'text-warning' : 'text-danger');
        });

        // Show validation summary if there are errors
        const summary = document.querySelector('[data-valmsg-summary]');
        if (summary && summary.querySelector('li')) {
            summary.style.display = 'block';
        }
    </script>
}
