@model PrisonerPortal.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["IsStandalone"] = true;
}

<div class="auth-split-container">
    <!-- Left Panel: Branding & Impact -->
    <div class="auth-left-panel d-none d-md-flex">
        <div class="text-center">
            <div class="portal-seal mx-auto mb-4">
                <svg class="seal-svg" width="180" height="180" viewBox="0 0 200 200">
                    <circle cx="100" cy="100" r="95" fill="none" stroke="#C8922A" stroke-width="2" />
                    <circle cx="100" cy="100" r="85" fill="none" stroke="#C8922A" stroke-width="1" stroke-dasharray="4 4" />
                    <path d="M70 140 L130 140 M100 140 L100 60 M75 80 L125 80 M75 80 Q75 110 90 120 M125 80 Q125 110 110 120" stroke="#C8922A" stroke-width="4" fill="none" stroke-linecap="round" />
                    <text x="100" y="165" font-family="DM Sans" font-size="8" fill="#C8922A" text-anchor="middle" font-weight="bold" letter-spacing="1">PRISONER FAMILY SUPPORT PORTAL</text>
                    <path d="M60 175 Q100 185 140 175" stroke="#C8922A" stroke-width="1" fill="none" />
                    <text x="100" y="188" font-family="DM Sans" font-size="7" fill="#C8922A" text-anchor="middle">SECURE ACCESS</text>
                </svg>
            </div>
            
            <h1 class="font-serif fw-bold display-4 text-white mb-3">Connecting Families</h1>
            <p class="text-white-50 fs-5 mb-5 mx-auto" style="max-width: 460px;">A secure bridge between families and correctional facilities, built on trust and transparency.</p>
            
            <div class="feature-pills justify-content-center">
                <div class="feature-pill"><i class="fa-solid fa-shield-halved me-2 text-accent"></i> Secure</div>
                <div class="feature-pill"><i class="fa-solid fa-eye me-2 text-accent"></i> Transparent</div>
                <div class="feature-pill"><i class="fa-solid fa-heart me-2 text-accent"></i> Compassionate</div>
            </div>
        </div>
    </div>

    <!-- Right Panel: Login Form -->
    <div class="auth-right-panel">
        <div class="auth-content-wrapper p-4">
            <!-- Mobile Logo -->
            <div class="portal-logo-mobile">
                <i class="fa-solid fa-shield-halved fs-1 text-primary mb-2"></i>
                <h3 class="font-serif fw-bold text-primary">PFSP</h3>
            </div>

            <div class="mb-5 animate-field">
                <h2 class="font-serif fw-bold text-primary mb-1">Welcome Back</h2>
                <p class="text-secondary small">Sign in to your account to manage visits and support.</p>
            </div>

            <form asp-action="Login" method="post" id="loginForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 border-start border-4 border-danger animate-field"></div>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 border-start border-4 border-success mb-4 animate-field">
                        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <!-- Email Field -->
                <div class="form-field-wrapper animate-field">
                    <div class="form-field">
                        <span class="field-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7"/></svg>
                        </span>
                        <input asp-for="Email" placeholder=" " autocomplete="email" />
                        <label asp-for="Email">Email Address</label>
                    </div>
                    <span asp-validation-for="Email" class="error-msg d-none"></span>
                </div>

                <!-- Password Field -->
                <div class="form-field-wrapper animate-field">
                    <div class="form-field">
                        <span class="field-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </span>
                        <input asp-for="Password" type="password" id="passwordInput" placeholder=" " autocomplete="current-password" />
                        <label asp-for="Password">Password</label>
                        <span class="password-toggle" data-target="passwordInput">
                            <i class="fa-solid fa-eye"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="error-msg d-none"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4 animate-field">
                    <div class="form-check custom-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary small">Stay signed in</label>
                    </div>
                    <a href="#" class="text-decoration-none small fw-bold text-accent">Forgot Password?</a>
                </div>

                <div class="mb-4 animate-field">
                    <button type="submit" class="auth-btn-primary" id="loginBtn">
                        <span class="btn-text">Sign In <i class="fa-solid fa-arrow-right ms-2"></i></span>
                        <span class="btn-loader d-none"><i class="fa-solid fa-circle-notch fa-spin me-2"></i> Signing In...</span>
                    </button>
                </div>

                <div class="text-center mb-4 animate-field">
                    <span class="text-muted small">─── OR ───</span>
                </div>

                <div class="animate-field">
                    <a asp-action="Register" class="auth-btn-outline d-block text-center text-decoration-none">
                        Create New Account
                    </a>
                </div>

                <div class="mt-5 text-center animate-field">
                    <p class="text-muted" style="font-size: 11px;">
                        <i class="fa-solid fa-lock me-1"></i> Protected by 256-bit SSL encryption
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            const form = this;
            if ($(form).valid()) {
                const btn = document.getElementById('loginBtn');
                if (btn.disabled) {
                    e.preventDefault();
                    return false;
                }
                btn.disabled = true;
                btn.classList.add('busy');
                btn.querySelector('.btn-text').classList.add('d-none');
                btn.querySelector('.btn-loader').classList.remove('d-none');
            }
        });
    </script>

}
