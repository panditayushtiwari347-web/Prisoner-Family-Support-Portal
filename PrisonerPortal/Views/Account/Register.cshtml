@model PrisonerPortal.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    ViewData["IsStandalone"] = true;
}

<div class="auth-split-container">
    <!-- Left Panel: Branding & Onboarding -->
    <div class="auth-left-panel d-none d-md-flex">
        <div class="text-center">
            <div class="portal-seal mx-auto mb-4">
                <svg class="seal-svg" width="160" height="160" viewBox="0 0 200 200">
                    <circle cx="100" cy="100" r="95" fill="none" stroke="#C8922A" stroke-width="2" />
                    <circle cx="100" cy="100" r="85" fill="none" stroke="#C8922A" stroke-width="1" stroke-dasharray="4 4" />
                    <path d="M70 140 L130 140 M100 140 L100 60 M75 80 L125 80 M75 80 Q75 110 90 120 M125 80 Q125 110 110 120" stroke="#C8922A" stroke-width="4" fill="none" stroke-linecap="round" />
                    <text x="100" y="165" font-family="DM Sans" font-size="8" fill="#C8922A" text-anchor="middle" font-weight="bold" letter-spacing="1">PRISONER FAMILY SUPPORT PORTAL</text>
                    <path d="M60 175 Q100 185 140 175" stroke="#C8922A" stroke-width="1" fill="none" />
                </svg>
            </div>
            
            <h1 class="font-serif fw-bold display-5 text-white mb-4">Join Our Portal</h1>
            
            <!-- Timeline Steps -->
            <div class="registration-steps text-start mx-auto" style="max-width: 320px;">
                <div class="reg-step d-flex mb-4">
                    <div class="step-num shadow-sm">1</div>
                    <div class="ms-3">
                        <div class="fw-bold text-white mb-1">Create Account</div>
                        <div class="small text-white-50">Provide your basic contact and identity details.</div>
                    </div>
                </div>
                <div class="reg-step d-flex mb-4">
                    <div class="step-num shadow-sm">2</div>
                    <div class="ms-3">
                        <div class="fw-bold text-white mb-1">Link to Prisoner</div>
                        <div class="small text-white-50">Search for your family member and request a verified link.</div>
                    </div>
                </div>
                <div class="reg-step d-flex">
                    <div class="step-num shadow-sm">3</div>
                    <div class="ms-3">
                        <div class="fw-bold text-white mb-1">Get Support</div>
                        <div class="small text-white-50">Book visits and submit support requests instantly.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Panel: Registration Form -->
    <div class="auth-right-panel">
        <div class="auth-content-wrapper p-4">
            
            <div class="mb-4 animate-field">
                <a asp-action="Login" class="text-decoration-none small fw-bold text-accent mb-2 d-inline-block">
                    <i class="fa-solid fa-arrow-left me-2"></i> Back to Login
                </a>
                <h2 class="font-serif fw-bold text-primary mb-1">Create Account</h2>
                <p class="text-secondary small">Fill in the details to register your portal account.</p>
            </div>

            <!-- Progress Indicator -->
            <div class="progress-container mb-5 animate-field">
                <div class="progress-line">
                    <div class="progress-line-fill" id="progress-line-fill" style="width: 50%;"></div>
                </div>
                <div class="step-dots d-flex justify-content-between">
                    <div class="step-dot active" id="step-dot-1">1</div>
                    <div class="step-dot" id="step-dot-2">2</div>
                </div>
                <div class="step-labels d-flex justify-content-between mt-2">
                    <span class="text-primary fw-bold small">Personal Info</span>
                    <span class="text-muted small">Account Security</span>
                </div>
            </div>

            <form asp-action="Register" method="post" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 @(!ViewData.ModelState.IsValid ? "d-block" : "d-none") animate-field"></div>

                <!-- STEP 1: Personal Information -->
                <div id="step-1">
                    <div class="form-field-wrapper animate-field">
                        <div class="form-field">
                            <span class="field-icon"><i class="fa-solid fa-user"></i></span>
                            <input asp-for="FullName" id="FullName" placeholder=" " autocomplete="name" />
                            <label asp-for="FullName">Full Name</label>
                        </div>
                        <span class="error-msg d-none"></span>
                    </div>

                    <div class="form-field-wrapper animate-field">
                        <div class="form-field">
                            <span class="field-icon"><i class="fa-solid fa-envelope"></i></span>
                            <input asp-for="Email" id="RegisterEmail" placeholder=" " autocomplete="email" />
                            <label asp-for="Email">Email Address</label>
                        </div>
                        <span class="error-msg d-none"></span>
                    </div>

                    <div class="form-field-wrapper animate-field">
                        <div class="form-field">
                            <span class="field-icon"><i class="fa-solid fa-phone"></i></span>
                            <input asp-for="PhoneNumber" id="PhoneNumber" placeholder=" " autocomplete="tel" />
                            <label asp-for="PhoneNumber">Phone Number</label>
                        </div>
                        <span class="error-msg d-none"></span>
                        <div class="form-text mt-1" style="font-size: 11px;">10-digit mobile number</div>
                    </div>

                    <div class="form-field-wrapper animate-field" style="margin-bottom: 30px;">
                        <div class="form-field align-items-start">
                            <span class="field-icon mt-3"><i class="fa-solid fa-location-dot"></i></span>
                            <textarea asp-for="Address" id="Address" rows="3" placeholder=" "></textarea>
                            <label asp-for="Address">Residential Address</label>
                        </div>
                        <span class="error-msg d-none"></span>
                    </div>

                    <div class="animate-field">
                        <button type="button" class="auth-btn-primary" onclick="nextStep()">
                            Next Step <i class="fa-solid fa-chevron-right ms-2"></i>
                        </button>
                    </div>
                </div>

                <!-- STEP 2: Account Security -->
                <div id="step-2" class="d-none">
                    <div class="form-field-wrapper animate-field">
                        <div class="form-field">
                            <span class="field-icon"><i class="fa-solid fa-lock"></i></span>
                            <input asp-for="Password" type="password" id="RegisterPassword" placeholder=" " autocomplete="new-password" />
                            <label asp-for="Password">Security Password</label>
                            <span class="password-toggle" data-target="RegisterPassword">
                                <i class="fa-solid fa-eye"></i>
                            </span>
                        </div>
                        
                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small text-muted">Strength: <strong id="strength-label"></strong></span>
                            </div>
                            <div class="strength-meter">
                                <div class="strength-bar"></div>
                                <div class="strength-bar"></div>
                                <div class="strength-bar"></div>
                                <div class="strength-bar"></div>
                            </div>
                            <div class="password-checklist mt-3 bg-light p-3 rounded border">
                                <div class="small fw-bold mb-2 text-primary">Requirements:</div>
                                <div class="small text-muted mb-1" id="req-len"><i class="fa-solid fa-circle-info me-2"></i> At least 8 characters</div>
                                <div class="small text-muted mb-1" id="req-upper"><i class="fa-solid fa-circle-info me-2"></i> At least one uppercase letter</div>
                                <div class="small text-muted mb-1" id="req-num"><i class="fa-solid fa-circle-info me-2"></i> At least one number</div>
                                <div class="small text-muted mb-0" id="req-spec"><i class="fa-solid fa-circle-info me-2"></i> One special character (!@@#$%^&*)</div>
                            </div>
                        </div>
                        <span asp-validation-for="Password" class="error-msg d-none"></span>
                    </div>

                    <div class="form-field-wrapper animate-field">
                        <div class="form-field">
                            <span class="field-icon"><i class="fa-solid fa-shield-check"></i></span>
                            <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword" placeholder=" " autocomplete="new-password" />
                            <label asp-for="ConfirmPassword">Confirm Password</label>
                            <span class="password-toggle" data-target="ConfirmPassword">
                                <i class="fa-solid fa-eye"></i>
                            </span>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="error-msg d-none"></span>
                    </div>

                    <div class="d-flex gap-3 animate-field mt-4">
                        <button type="button" class="auth-btn-outline" style="width: 120px;" onclick="prevStep()">
                            <i class="fa-solid fa-chevron-left me-2"></i> Back
                        </button>
                        <button type="submit" class="auth-btn-primary" id="registerBtn">
                            <span class="btn-text">Create Account <i class="fa-solid fa-user-plus ms-2"></i></span>
                            <span class="btn-loader d-none"><i class="fa-solid fa-circle-notch fa-spin me-2"></i> Processing...</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
/* Register Specific UI */
.registration-steps { position: relative; padding-left: 20px; }
.reg-step { position: relative; z-index: 1; }
.reg-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 17px;
    top: 35px;
    height: 40px;
    width: 2px;
    background: rgba(255,255,255,0.1);
    border-left: 2px dashed rgba(255,255,255,0.2);
}

.step-num {
    width: 36px;
    height: 36px;
    background: var(--accent);
    color: var(--primary-dark);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    flex-shrink: 0;
}

/* Progress Bar */
.progress-container { position: relative; }
.progress-line {
    position: absolute;
    top: 18px;
    left: 5%;
    right: 5%;
    height: 2px;
    background: var(--border);
    z-index: 0;
}
.progress-line-fill {
    height: 100%;
    background: var(--primary);
    transition: width 0.35s ease-in-out;
}
.step-dots { position: relative; z-index: 1; }
.step-dot {
    width: 36px;
    height: 36px;
    background: white;
    border: 2px solid var(--border);
    color: var(--text-muted);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    transition: var(--transition);
}
.step-dot.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
    box-shadow: 0 0 0 5px rgba(27, 58, 107, 0.1);
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const form = this;
            if ($(form).valid()) {
                const btn = document.getElementById('registerBtn');
                if (btn.disabled) {
                    e.preventDefault();
                    return false;
                }
                btn.disabled = true;
                btn.classList.add('busy');
                btn.querySelector('.btn-text').classList.add('d-none');
                btn.querySelector('.btn-loader').classList.remove('d-none');
            }
        });
    </script>

}
