@model PrisonerPortal.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row g-4">
    <div class="col-lg-4">
        <!-- Profile Summary -->
        <div class="card content-card text-center text-lg-start h-100">
            <div class="d-flex flex-column align-items-center mb-4">
                <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mb-3 shadow" style="width: 100px; height: 100px; font-size: 2.5rem;">
                    <i class="fa-solid fa-user"></i>
                </div>
                <h4 class="font-serif fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted mb-2">@Model.Email</p>
                <span class="badge bg-light text-dark border">Role: @Model.Role</span>
            </div>
            
            <hr class="text-muted opacity-25" />
            
            <div class="mt-4">
                <h6 class="text-uppercase text-muted fw-bold small mb-3">Account Security</h6>
                <a asp-action="ChangePassword" asp-controller="Account" class="btn btn-outline-secondary w-100 mb-2">
                    <i class="fa-solid fa-key me-2"></i> Change Password
                </a>
                <form asp-action="Logout" method="post" class="mt-3">
                    <button type="submit" class="btn btn-light text-danger w-100 border">
                        <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Sign Out
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8">
        <!-- Edit Profile Form -->
        <div class="card content-card h-100">
            <h4 class="font-serif fw-bold mb-4 border-bottom pb-3">Personal Details</h4>
            
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row mb-3">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label fw-semibold">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Address" class="field-validation-error"></span>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="reset" class="btn btn-light me-2">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-2"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
